{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Account Browser",
  "version": "0.7.0",
  "identifier": "ai.openai.multiaccountbrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Multi Account Browser",
        "width": 1480,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
